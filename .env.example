# Backend base URL, without /v1. Use https:// in production — browsers block
# http:// API calls from an https:// page (mixed content).
VITE_API_URL=https://api.example.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional — the Google sign-in button is hidden when this is empty.
VITE_GOOGLE_CLIENT_ID=
